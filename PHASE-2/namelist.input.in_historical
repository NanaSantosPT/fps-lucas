 km_opt                              = 4,           ! eddy coefficient option; 4:horizontal Smagorinsky first order closure
 damp_opt                            = 3,           ! upper level damping; 3: with w-Rayleigh damping
 diff_6th_opt                        = 2,           ! 6th-order numerical diffusion; 2: 6th-order numerical diffusion but prohibit up-gradient diffusion
 diff_6th_factor                     = 0.12,        ! 6th-order numerical diffusion non-dimensional rate
 dampcoef                            = 0.2,         ! damping coefficient
 base_temp                           = 290.,        ! real-data, em ONLY, base sea-level temperature for base state (K)
 khdif                               = 0,           ! horizontal diffusion constant (m^2/s)
