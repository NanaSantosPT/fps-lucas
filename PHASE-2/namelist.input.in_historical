&physics
 mp_physics                          = 8,           ! microphysics option; 8: Thompson scheme
 ra_lw_physics                       = 4,           ! longwave radiation option; 4:RRTMG scheme
 ra_sw_physics                       = 4,           ! shortwave radiation option; 4:RRTMG scheme
 radt                                = 12,          ! time interval for radiation physics calls (in minutes)
 swint_opt                           = 1,           ! interpolation of short-wave radiation based on the updated solar zenith angle between SW call; 1: use interpolation
 o3input                             = 2,           ! ozone input option for radiation (RRTMG only); 2: CAM ozone data (ozone.formatted)
 use_aero_icbc                       = .false.,     ! climatological aerosol input; use constant values (.false.) or climatological aerosol input from WPS (.true.)
 aer_opt                             = 2,           ! aerosol input option for radiation (RRTMG only); MACv2-SP aerosol scheme (LUCAS FPS)
 aer_aod550_opt                      = 2,           ! read AOD550 from auxinput15 (LUCAS FPS)
 aer_angexp_opt                      = 3,           ! read Angstrom exponent from auxinput15 (LUCAS FPS)
 aer_ssa_opt                         = 3,           ! read Single Scattering Albedo from auxinput15 (LUCAS FPS)
 aer_asy_opt                         = 3,           ! read Asymmetry parameter from auxinput15 (LUCAS FPS)
 aer_type                            = 1,           ! aerosol type; 1: rural
 sf_sfclay_physics                   = 5,           ! surface-layer option; 5: MYNN surface layer
 sf_surface_physics                  = 4,           ! land-surface option; 4: Noah-MP land-surface model (see additional &noah_mp)
 sf_surface_mosaic                   = 0,           ! option to mosaic landuse categories for Noah LSM; 0: no mosaic approach
 mosaic_cat                          = 3,           ! number of mosaic landuse categories in a grid cell
 sf_urban_physics                    = 0,           ! activate urban canopy model; 0: not active
 sf_lake_physics                     = 0,           ! activate lake model; 0: not active
 bl_pbl_physics                      = 5,           ! boundary-layer option; 5: MYNN 2.5 level TKE PBL scheme
 bldt                                = 0,           ! time interval between boundary-layer calls (in minutes, 0=every step)
 grav_settling                       = 0,           ! gravitational settling of fog/cloud droplets; 0: no settling
 bl_mynn_closure                     = 2.5,         ! MYNN closure parameter; 2.5: level 2.5
 bl_mynn_cloudmix                    = 1,           ! mixing of qc and qi in MYNN; 1: mixing activated
 bl_mynn_mixlength                   = 1,           ! mixing length formulation in MYNN; 1: RAP/HRRR (including BouLac in free atmosphere)
 bl_mynn_cloudpdf                    = 2,           ! cloud PDFs to represent subgrid clouds; 2: Chaboureau and Bechtold 2002
 bl_mynn_edmf                        = 1,           ! activate mass-flux option in MYNN; 1: activated (0 if shallow cumulus scheme is used)
 bl_mynn_edmf_mom                    = 1,           ! activate momentum transport in MYNN; 1: activated (0 if shallow cumulus scheme is used)
 bl_mynn_edmf_tke                    = 1,           ! activate TKE transport in MYNN; 1: activated (0 if shallow cumulus scheme is used)
 scalar_pblmix                       = 1,           ! mix scalar fields consistent with PBL option
 tracer_pblmix                       = 1,           ! mix tracer fields consistent with PBL option
 cu_physics                          = 1,           ! cumulus option; 1: Kain-Fritsch (new Eta) scheme
 shcu_physics                        = 0,           ! independent shallow cumulus option (not tied to deep convection); 0: no independent shallow cumulus
 cu_rad_feedback                     = .true.,      ! enable cumulus radiation feedback
 cudt                                = 0,           ! time interval between cumulus calls (in minutes, 0=every step)
 isfflx                              = 1,           ! heat and moisture fluxes from the surface; 1: with fluxes from the surface
 ifsnow                              = 1,           ! snow-cover effects; 1: with snow-cover effects
 icloud                              = 1,           ! cloud effect to the optical depth in radiation; 1: with cloud effect, and use cloud fraction option 1 (Xu-Randall method)
 icloud_bl                           = 1,           ! couple the subgrid-scale clouds from the PBL scheme to radiation; 1: activate coupling to radiation
 surface_input_source                = 1,           ! where landuse and soil category data come from; 1: WPS/geogrid with dominant categories recomputed (LUCAS FPS)
 num_soil_layers                     = 4,           ! number of soil layers; 4: Noah landsurface model
 num_land_cat                        = 21,          ! number of land categories; 21: for MODIS if including lake category
 maxiens                             = 1,           ! Grell-Devenyi only
 maxens                              = 3,           ! Grell-Devenyi only
 maxens2                             = 3,           ! Grell-Devenyi only
 maxens3                             = 16,          ! Grell-Devenyi only
 ensdim                              = 144,         ! Grell-Devenyi only
 sst_update                          = 1,           ! time-varying sea-surface temperature; 1: yes, using data from auxinput4
 usemonalb                           = .false.,     ! use monthly albedo map instead of table value (recommended for sst_update=1)
 rdlai2d                             = .false.,     ! use LAI from input; false means using values from table
 bucket_mm                           = 1000.0,      ! bucket reset value for water accumulations (in mm) - precipitation
 bucket_J                            = 1.e9,        ! bucket reset value for energy accumulations (in J) - radiation
 tmn_update                          = 1,           ! update deep soil temperature; 1: yes
 sst_skin                            = 1,           ! calculate skin SST
 slope_rad                           = 0,           ! slope effects for solar radiation; 0: off
 topo_shading                        = 0,           ! neighboring-point shadow effects for solar radiation; 0: off
 fractional_seaice                   = 0,           ! treat sea-ice as fractional field (1) or ice/no-ice flag (0)
/

&noah_mp
 dveg                                = 3,           ! dynamic vegetation option; 3: Off (use table LAI; calculate FVEG) (LUCAS FPS)
 opt_crs                             = 1,           ! stomatal resistance option; 1: Ball-Berry
 opt_sfc                             = 1,           ! surface layer drag coefficient calculation; 1: Monin-Obukhov
 opt_btr                             = 2,           ! soil moisture factor for stomatal resistance; 2: CLM
 opt_run                             = 1,           ! surface runoff option; 1: TOPMODEL with groundwater
 opt_frz                             = 1,           ! supercooled liquid water option; 1: no iteration
 opt_inf                             = 2,           ! soil permeability option; 2: non-linear effects, less permeable
 opt_rad                             = 3,           ! radiative transfer option; 3: two-stream applied to vegetated fraction
 opt_alb                             = 2,           ! ground surface albedo option; 2: CLASS
 opt_snf                             = 3,           ! precipitation partitioning between snow and rain; 3: snow when SFCTMP < TFRZ
 opt_tbot                            = 2,           ! soil temperature lower boundary condition; 2: TBOT at 8 m from input file
 opt_stc                             = 1,           ! snow/soil temperature time scheme; 1: semi-implicit
 opt_gla                             = 1,           ! glacier treatment option; 1: includes phase change
 opt_rsf                             = 1,           ! surface evaporation resistance option; 1: Sakaguchi and Zeng, 2009
/

&fdda
/

&dynamics
 zdamp                               = 5000.,       ! damping depth (m) from model top
 w_damping                           = 1,           ! vertical velocity damping; 1: with damping
