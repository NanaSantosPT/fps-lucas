&time_control
 run_hours                           = 0,
 start_year                          = _START_YY_,                   ! four digit year of starting time
 start_month                         = _START_MM_,                   ! two digit month of starting time
 start_day                           = _START_DD_,                   ! two digit day of starting time
 start_hour                          = _START_HH_,                   ! two digit hour of starting time
 start_minute                        = 00,                           ! two digit minute of starting time
 start_second                        = 00,                           ! two digit second of starting time
 end_year                            = _END_YY_,                     ! four digit year of ending time
 end_month                           = _END_MM_,                     ! two digit month of ending time
 end_day                             = _END_DD_,                     ! two digit day of ending time
 end_hour                            = _END_HH_,                     ! two digit hour of ending time
 end_minute                          = 00,                           ! two digit minute of ending time
 end_second                          = 00,                           ! two digit second of ending time
 interval_seconds                    = 21600,                        ! time interval between incoming real data (in seconds); 6h*60min*60s=21600s
 input_from_file                     = .true.,                       ! whether nested run has input files
 fine_input_stream                   = 0,                            ! field selection from nested file; 0: all fields are used
 history_interval                    = 60,                           ! history output file interval (in minutes)
 frames_per_outfile                  = 1,                            ! number of output times per history file
 restart                             = _RESTART_TF_,                 ! whether this run is a restart
 restart_interval                    = _RESTART_I_,                  ! restart output interval (in minutes); n_days*24h*60min
 override_restart_timers             = .true.,                       ! whether to change the alarms from what is previously set
 write_hist_at_0h_rst                = .true.,                       ! whether to output history file at the start of restart run
 io_form_history                     = 2,                            ! netCDF format for history files
 io_form_restart                     = 2,                            ! netCDF format for restart files
 io_form_input                       = 2,                            ! netCDF format for input files
 io_form_boundary                    = 2,                            ! netCDF format for boundary files
 debug_level                         = 0,                            ! debug message level
 diag_print                          = 0,                            ! print out time series of model diagnostics; 0: no print
!! --- AUXILIARY INPUTS (auxinput[2-24]) ---
! -> One-way Nested Run Using ndown
 io_form_auxinput2                   = 2,                            ! netCDF format
! -> SST updating (used only with sst_update=1)
 auxinput4_inname                    = "wrflowinp_d<domain>",        ! filename for SST updating
 auxinput4_interval                  = 360,                          ! time interval for SST updating matching interval_seconds (in minutes); 6h*60min=360min
 io_form_auxinput4                   = 2,                            ! netCDF format
! -> Radiation options: Aerosols
 auxinput15_inname                   = _AOD_,                        ! filename for aerosol input data (LUCAS FPS)
 auxinput15_interval                 = 1440,                         ! time interval for aerosol input (in minutes); 24h*60min=1440min
 io_form_auxinput15                  = 2,                            ! netCDF format
!! --- AUXILIARY OUTPUTS (auxhist[1-24]) ---
! -> Additional regional climate surface fields (WRFxtrm)
 output_diagnostics                  = 1,                            ! write extreme values (Tmax, Tmin, etc.) to auxhist3
 auxhist3_outname                    = "wrfxtrm_d<domain>_<date>",   ! filename for extreme values
 auxhist3_interval                   = 1440,                         ! output interval (in minutes); 24h*60min=1440min
 io_form_auxhist3                    = 2,                            ! netCDF format
 frames_per_auxhist3                 = _DAYS_XTR_,                   ! number of output times per auxhist3 file
! -> CORDEX-WRF
! auxhist9_outname                   = "wrfcdx_d<domain>_<date>",    ! filename for CORDEX-specific output
! auxhist9_interval                  = 60,                           ! output interval (in minutes); 1h*60min=60min
! io_form_auxhist9                   = 2,                            ! netCDF format
! frames_per_auxhist9                = 24,                           ! number of output times per auxhist9 file
! -> Soil initialisation
! auxhist14_outname                  = "wrfhrly_d<domain>_<date>",   ! filename for hourly soil/surface output
! auxhist14_interval                 = 60,                           ! output interval (in minutes); 1h*60min=60min
! io_form_auxhist14                  = 2,                            ! netCDF format
! frames_per_auxhist14               = 1,                            ! number of output times per auxhist14 file
! -> Pressure level diagnostic output
! auxhist23_outname                  = "wrfpress_d<domain>_<date>",  ! filename for pressure-level diagnostics
! auxhist23_interval                 = 60,                           ! output interval (in minutes); 1h*60min=60min
! io_form_auxhist23                  = 2,                            ! netCDF format
! frames_per_auxhist23               = 24,                           ! number of output times per auxhist23 file
!! --- RUN-TIME I/O OPTIONS ---
 iofields_filename                   = "_OUTFIELDS_",                ! file with list of variables to include/exclude
 nocolons                            = _NOCOLONS_,                   ! write the output files with _ instead of : (cannot be used with real.exe)
/

&domains
 time_step                           = 60,          ! main time step in seconds
 time_step_fract_num                 = 0,           ! numerator for fractional time step
 time_step_fract_den                 = 1,           ! denominator for fractional time step
 max_dom                             = 1,           ! number of domains
 s_we                                = 1,           ! start index in x (west-east)
 e_we                                = 445,         ! end index in x (west-east)
 s_sn                                = 1,           ! start index in y (south-north)
 e_sn                                = 433,         ! end index in y (south-north)
 s_vert                              = 1,           ! start index in z (vertical)
 e_vert                              = 54,          ! end index in z (vertical)
 p_top_requested                     = 2000.,       ! p_top (Pa) to use; top of atmosphere is at 20 hPa
 dx                                  = 12229.52,    ! grid spacing in x (in meters)
 dy                                  = 12229.52,    ! grid spacing in y (in meters)
 grid_id                             = 1,           ! domain identifier
 parent_id                           = 0,           ! id of the parent domain
 i_parent_start                      = 1,           ! x starting index in parent
 j_parent_start                      = 1,           ! y starting index in parent
 parent_grid_ratio                   = 1,           ! parent-to-nest grid ratio
 parent_time_step_ratio              = 1,           ! parent-to-nest time step ratio
 feedback                            = 0,           ! 0: no feedback (nest to parent)
 smooth_option                       = 0,           ! 0: no smoothing (nest to parent)
 num_metgrid_levels                  = 26,          ! number of vertical levels of 3d meteorological fields input
 num_metgrid_soil_levels             = 4,           ! number of vertical soil levels or layers input
 auto_levels_opt                     = 2,           ! automatic level generation; (also set dzstretch_s, dzstretch_u, dzbot, max_dz)
 dzstretch_s                         = 1.20,        ! surface stretch factor for auto_levels_opt=2
 dzstretch_u                         = 1.04,        ! upper stretch factor for auto_levels_opt=2
 max_dz                              = 1000,        ! maximum level thickness allowed (m) for auto_levels_opt=2
 dzbot                               = 35,          ! thickness of lowest layer (m) for auto_levels_opt=2; lowest model level at 35m
 sfcp_to_sfcp                        = .true.,      ! compute surface pressure from pressure-level input
/

