 epssm                               = 0.3,         ! time off-centering for vertical sound waves
 non_hydrostatic                     = .true.,      ! whether running the model in hydrostatic (.false.) or non-hydro (.true.) mode
 moist_adv_opt                       = 1,           ! advection options for moisture; 1: original
 scalar_adv_opt                      = 1,           ! advection options for scalar; 1: original
/

